# Credenciales de Firebase.
# Copia este archivo como .env.local y rellena los valores desde la consola:
# Configuracion del proyecto - Tus apps - hospeda365-web
#
# Sin este archivo el sitio igual funciona: si faltan las credenciales,
# la app usa los datos mock de datos/. No hace falta configurar nada
# para levantar el proyecto y trabajar en la interfaz.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: fuerza los datos mock aunque haya credenciales.
# NEXT_PUBLIC_USAR_MOCKS=true
