rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(userId) {
      return autenticado() && request.auth.uid == userId;
    }

    function perfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function rol() {
      return autenticado() ? perfil().rol : 'anonimo';
    }

    function esAdmin() {
      return rol() == 'admin';
    }

    function esPersonal() {
      return rol() == 'admin' || rol() == 'recepcionista';
    }

    function activo() {
      return autenticado() && perfil().activo == true;
    }

    function noModifica(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(campos.toSet());
    }

    function soloModifica(campos) {
      return request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(campos.toSet());
    }

    match /users/{userId} {

      allow read: if esDueno(userId) || esPersonal();

      allow create: if esDueno(userId)
                    && request.resource.data.rol == 'huesped'
                    && request.resource.data.activo == true
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.keys().hasAll([
                         'email', 'nombre', 'apellido', 'rol', 'activo'
                       ]);

      allow update: if (esDueno(userId) && noModifica(['rol', 'email', 'activo']))
                    || esAdmin();

      allow delete: if false;
    }

    match /rooms/{roomId} {

      allow read: if resource.data.activa == true || esPersonal();

      allow create, delete: if esAdmin() && activo();

      allow update: if activo() && (
                      esAdmin()
                      || (rol() == 'recepcionista'
                          && noModifica(['precioNoche', 'tipo', 'capacidad', 'numero']))
                    )
                    && request.resource.data.estado in
                       ['disponible', 'ocupada', 'limpieza', 'mantenimiento'];

      match /historial/{eventoId} {
        allow read:   if esPersonal();
        allow create: if esPersonal() && activo();
        allow update, delete: if false;
      }
    }

    match /reservations/{reservaId} {

      allow read: if esPersonal()
                  || (autenticado() && resource.data.usuarioId == request.auth.uid);

      allow create: if activo()
                    && (
                      (request.resource.data.usuarioId == request.auth.uid
                       && request.resource.data.estado == 'pendiente'
                       && request.resource.data.estadoPago in ['sin_comprobante', 'en_revision'])
                      || (esPersonal()
                          && request.resource.data.estado in
                             ['pendiente', 'confirmada', 'en_curso', 'finalizada', 'cancelada', 'rechazada']
                          && request.resource.data.estadoPago in
                             ['sin_comprobante', 'en_revision', 'aprobado', 'rechazado'])
                    )
                    && request.resource.data.fechaEntrada < request.resource.data.fechaSalida
                    && request.resource.data.numeroHuespedes > 0
                    && request.resource.data.total >= 0;

      allow update: if activo() && (
                      esPersonal()
                      || (resource.data.usuarioId == request.auth.uid
                          && soloModifica(['estado', 'actualizadaEn'])
                          && request.resource.data.estado == 'cancelada')
                    );

      allow delete: if false;
    }

    match /payments/{pagoId} {

      allow read: if esPersonal()
                  || (autenticado() && resource.data.usuarioId == request.auth.uid);

      allow create: if activo()
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.estado == 'en_revision'
                    && request.resource.data.monto > 0;

      allow update: if esPersonal() && activo()
                    && request.resource.data.estado in ['aprobado', 'rechazado', 'en_revision'];

      allow delete: if false;
    }

    match /metrics/{periodo} {

      allow read: if esPersonal();

      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
